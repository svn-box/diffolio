{
	"name": "diffolio",
	"version": "0.1.0",
	"description": "A considered file comparison workspace for macOS",
	"private": true,
	"author": "Kelvin",
	"main": "out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"start": "electron-vite preview",
		"typecheck": "tsc --noEmit",
		"build": "npm run typecheck && electron-vite build",
		"test": "vitest run",
		"test:e2e": "npm run build && node scripts/e2e.mjs",
		"test:entry": "npm run build && node scripts/entry-e2e.mjs",
		"format": "prettier --write src tests scripts electron.vite.config.ts package.json tsconfig.json",
		"format:check": "prettier --check src tests scripts electron.vite.config.ts package.json tsconfig.json",
		"icons:build": "node scripts/build-icons.mjs",
		"docs:screenshots": "npm run package:dir && node scripts/capture-readme.mjs",
		"package:dir": "npm run icons:build && npm run build && electron-builder --mac dir --publish never",
		"design:check": "node scripts/design-tokens.mjs",
		"test:packaged": "node scripts/smoke-packaged.mjs"
	},
	"build": {
		"appId": "app.diffolio.desktop",
		"productName": "Diffolio",
		"directories": {
			"output": "release"
		},
		"files": [
			"out/**/*",
			"package.json"
		],
		"mac": {
			"category": "public.app-category.developer-tools",
			"identity": null,
			"target": [
				"dir"
			],
			"icon": "resources/icon-concepts/frosted-diff/Diffolio.icon"
		}
	},
	"dependencies": {
		"@codemirror/commands": "6.11.1",
		"@codemirror/lang-css": "6.3.1",
		"@codemirror/lang-html": "6.4.12",
		"@codemirror/lang-javascript": "6.2.5",
		"@codemirror/lang-json": "6.0.2",
		"@codemirror/lang-markdown": "6.5.2",
		"@codemirror/language": "6.13.1",
		"@codemirror/merge": "6.12.3",
		"@codemirror/search": "6.7.2",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"@lezer/highlight": "1.2.5",
		"@radix-ui/react-popover": "1.3.1",
		"@radix-ui/react-slot": "1.5.0",
		"class-variance-authority": "0.7.1",
		"clsx": "2.1.1",
		"cmdk": "1.1.1",
		"lucide-react": "1.61.0",
		"react": "19.3.1",
		"react-dom": "19.3.1",
		"tailwind-merge": "3.7.0",
		"zustand": "5.0.16"
	},
	"devDependencies": {
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@vitejs/plugin-react": "6.1.2",
		"electron": "45.0.0",
		"electron-builder": "26.18.0",
		"electron-vite": "6.0.0",
		"playwright": "1.64.1",
		"prettier": "3.9.10",
		"typescript": "7.0.2",
		"vite": "8.3.5",
		"vitest": "5.0.5"
	}
}
